proc replica_centers { mycolvars } {
    global harm cvsd r2d
    set d 0
    set cnt "centers \{ "

    foreach cvd $cvsd {
        if { $cvd == 4 } {
            append cnt " ( " [lindex $mycolvars $d] " , " [lindex $mycolvars [expr {$d+1}]] " , " \
                           [lindex $mycolvars [expr {$d+2}]] " , " [lindex $mycolvars [expr {$d+3}]] " ) "
            set d [expr {$d+4}]

        } elseif { $cvd == 3 } {
            append cnt " ( " [lindex $mycolvars $d] " , " [lindex $mycolvars [expr {$d+1}]] " , " \
                           [lindex $mycolvars [expr {$d+2}]] " ) "
            set d [expr {$d+3}]

        } elseif { $cvd == 2 } {
            append cnt " ( " [lindex $mycolvars $d] " , " [lindex $mycolvars [expr {$d+1}]] " ) "
            set d [expr {$d+2}]

        } elseif { $cvd == 1 } {
            append cnt [lindex $mycolvars $d] " "
            set d [expr {$d+1}]

        } elseif { $cvd == 0 } {
            # periodic scalar stored internally as (sin, cos)
            set s [lindex $mycolvars $d]
            set c [lindex $mycolvars [expr {$d+1}]]
            set ang [expr {$r2d * atan2($s, $c)}]  ;# degrees

            # optional: wrap to (-180, 180]
            if { $ang <= -180.0 } { set ang [expr {$ang + 360.0}] }
            if { $ang >   180.0 } { set ang [expr {$ang - 360.0}] }

            append cnt $ang " "
            set d [expr {$d+2}]
        } else {
            error "Unsupported cvsd entry: $cvd"
        }
    }

    append cnt " \}"
    return [list $harm "$cnt"]
}

