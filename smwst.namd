###########################################################################
# String Method with Swarms of Trajectories (SMwST)
# Mahmoud Moradi, University of Illinois (moradi@illinois.edu)
# Modified by Ashkan Fakhar, University of Illinois (afakhar@illinois.edu) 
# TODO: add remove loops
###########################################################################

set replica_id [myReplica]
set image_id [expr $replica_id/$nc]
set copy_id [expr $replica_id%$nc]

if {![info exists ns]} { set ns 1 }
if {![string is integer -strict $ns] || $ns < 1} {
    error "ns must be a positive integer"
}

if {[llength $cvsd]==1&&[llength $cvs]>1} {
    set cvd $cvsd
    for {set i 1} {$i<[llength $cvs]} {incr i} {
	lappend cvsd $cvd
    }
}

if {[llength $cvsm]==1&&[llength $cvs]>1} {
    set cvm $cvsm
    for {set i 1} {$i<[llength $cvs]} {incr i} {
	lappend cvsm $cvm
    }
}

###################################
# input/output setting

source $system_conf

# If you wanna specify an image_id and a copy_id in your output (e.g. output/%s/XX_%s; otherwise just an image_id)
#set output_name [format $output_root $image_id $copy_id]
set output_name [format $output_root $image_id]

if { $job_id > 0 } { #restart
    set old_job_id [expr $job_id-1]
    set input_name $output_name.job$old_job_id.$replica_id.restart
} else {
    # If you have specified an image_id and a copy_id in your input (otherwise just an image_id)
    #set input_name [format $input_root $image_id $copy_id]
    set input_name [format $input_root $image_id]
}

outputname $output_name.job$job_id.$replica_id

if {[info exists input_root]||[info exists old_job_id]} { #do you have *.coor files?
    bincoordinates $input_name.coor
}
if {([info exists input_root]&&$usevel)||[info exists old_job_id]} { #do you have *.vel files?
    binvelocities $input_name.vel
} else {
    if {[info exists temperature]} {
	temperature $temperature
    } else {
	error "temperature is not set!"
    }
}
if {([info exists input_root]&&$usexsc)||[info exists old_job_id]} { #do you have *.xsc files?
    extendedSystem $input_name.xsc
    set myxscfile $input_name.xsc
    if {!$zerotime} { #do you want to keep the time informations
	set firsttimestepfile $input_name.xsc
    }
} else {
    cellBasisVector1    [lindex $cellinfo 0]
    cellBasisVector2    [lindex $cellinfo 1]
    cellBasisVector3    [lindex $cellinfo 2]
    cellOrigin          [lindex $cellinfo 3]
}

proc get_firsttime { xscfile } {
    set fd [open $xscfile r]
    gets $fd
    gets $fd
    gets $fd line
    set ts [lindex $line 0]
    close $fd
    return $ts
}

if {[info exists firsttimestepfile]} {
    set firsttime [get_firsttime $myxscfile]
} else {
    set firsttime 0
}
firsttimestep $firsttime
#firsttimestep 0

###############################################
# Some handy variables

# number of replicas
set nr [numReplicas]
# number of images
set ni [expr $nr/$nc]

set nci [expr 1.0/$nc]
set ncs [expr 1.0/($nc*$ns)]
set nii [expr 1.0/$ni]

set oneminussmooth [expr 1-$smooth]
set halfsmooth [expr $smooth/2.0]
set ni1 [expr $ni-1]; # last image

set random_update $randomized_update
set fixed_end     $fixed_ends
set rand_alpha    0.35; # we will adjust this to vary

set num_equil_stages $numStages 
set equil_steps_per_stage [expr int($runE / $num_equil_stages)]
set equil_stage_expon 1

set pi  [expr {acos(-1.0)}]
set r2d [expr {180.0/$pi}]
set d2r [expr {$pi/180.0}]

set debug 1

# AFX: Conservative center update and adaptive diagonal metric defaults.
if {![info exists update_fraction]} { set update_fraction 0.2 }
if {![info exists adaptive_cvsm]} { set adaptive_cvsm 1 }
if {![info exists cvsm_relaxation]} { set cvsm_relaxation 0.2 }
if {![info exists cvsm_min]} { set cvsm_min 0.0001 }
if {![info exists cvsm_max]} { set cvsm_max 0.01 }

if {$update_fraction < 0.0 || $update_fraction > 1.0} {
    error "update_fraction must be between 0 and 1"
}
if {$cvsm_relaxation < 0.0 || $cvsm_relaxation > 1.0} {
    error "cvsm_relaxation must be between 0 and 1"
}

# AFX: Restore the string centers and adaptive metric from the previous job.
if {$replica_id == 0 && $job_id > 0} {
    set center_state "${output_name}.job${old_job_id}.centers"
    if {![file readable $center_state]} {
        error "Cannot read previous string centers: $center_state"
    }

    set fd [open $center_state r]
    while {[gets $fd line] >= 0} {
        if {[llength $line] == 0} { continue }
        if {[lindex $line 0] eq "cvsm"} {
            set cvsm [lrange $line 1 end]
        } else {
            set I [lindex $line 0]
            set string_center($I) [lrange $line 1 end]
        }
    }
    close $fd

    if {[array size string_center] != $ni} {
        error "Expected $ni string centers in $center_state"
    }
    #print "AFX Restored cvsm" $cvsm
}

