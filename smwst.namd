#	    incr my_d 1
#	}
#    }
#    return [expr "sqrt($my_length)"]
#}

proc colvars_length { v } {
    global cvsm cvsd
    set d 0
    set sum 0.0
    for {set cv 0} {$cv < [llength $cvsd]} {incr cv} {
        set cvd [lindex $cvsd $cv]
        set w   [lindex $cvsm $cv]

        if { $cvd == 0 } {
            # periodic scalar stored as 2 comps
            set x [lindex $v $d]
            set y [lindex $v [expr {$d+1}]]
            set sum [expr {$sum + $w*($x*$x + $y*$y)}]
            set d [expr {$d+2}]
        } else {
            for {set k 0} {$k < $cvd} {incr k} {
                set x [lindex $v [expr {$d+$k}]]
                set sum [expr {$sum + $w*($x*$x)}]
            }
            set d [expr {$d+$cvd}]
        }
    }
    return [expr {sqrt($sum)}]
}

# AFX: Estimate a common scalar-CV weight from the current string spread.
# Quaternion weights remain fixed; the scalar weight is relaxed and bounded.
proc cv_dot { a b } {
    set value 0.0
    foreach x $a y $b { set value [expr {$value + $x*$y}] }
    return $value
}

proc estimate_cvsm { path } {
    global cvsd cvsm cvsm_relaxation cvsm_min cvsm_max

    set n [llength $path]
    set d 0
    set qvar_sum 0.0
    set zvar_sum 0.0
    set qweight_sum 0.0
    set nq 0
    set nz 0

    for {set cv 0} {$cv < [llength $cvsd]} {incr cv} {
        set cvd [lindex $cvsd $cv]

        if {$cvd == 4} {
            set ref [lrange [lindex $path 0] $d [expr {$d+3}]]
            set qmean {0.0 0.0 0.0 0.0}
            set quaternions {}

            foreach point $path {
                set q [lrange $point $d [expr {$d+3}]]
                if {[cv_dot $ref $q] < 0.0} { set q [vecscale $q -1.0] }
                lappend quaternions $q
                set qmean [vecadd $qmean $q]
            }

            set qnorm [veclength $qmean]
            if {$qnorm > 1e-12} { set qmean [vecscale $qmean [expr {1.0/$qnorm}]] }

            set variance 0.0
            foreach q $quaternions {
                if {[cv_dot $qmean $q] < 0.0} { set q [vecscale $q -1.0] }
                set dq [vecsub $q $qmean]
                set variance [expr {$variance + [cv_dot $dq $dq]}]
            }
            set qvar_sum [expr {$qvar_sum + $variance/double($n)}]
            set qweight_sum [expr {$qweight_sum + [lindex $cvsm $cv]}]
            incr nq
            set d [expr {$d+4}]

        } elseif {$cvd == 1} {
            set mean 0.0
            foreach point $path { set mean [expr {$mean + [lindex $point $d]}] }
            set mean [expr {$mean/double($n)}]

            set variance 0.0
            foreach point $path {
                set dx [expr {[lindex $point $d] - $mean}]
                set variance [expr {$variance + $dx*$dx}]
            }
            set zvar_sum [expr {$zvar_sum + $variance/double($n)}]
            incr nz
            incr d

        } elseif {$cvd == 0} {
            set d [expr {$d+2}]
        } else {
            set d [expr {$d+$cvd}]
        }
    }

    if {$nq == 0 || $nz == 0 || $qvar_sum < 1e-12 || $zvar_sum < 1e-12} {
        return [list $cvsm "unchanged" 0.0 0.0]
    }

    set qvar [expr {$qvar_sum/double($nq)}]
    set zvar [expr {$zvar_sum/double($nz)}]
    set qweight [expr {$qweight_sum/double($nq)}]
    set target [expr {$qweight*$qvar/$zvar}]
    if {$target < $cvsm_min} { set target $cvsm_min }
    if {$target > $cvsm_max} { set target $cvsm_max }

    set new_cvsm {}
    for {set cv 0} {$cv < [llength $cvsd]} {incr cv} {
        set old_weight [lindex $cvsm $cv]
        if {[lindex $cvsd $cv] == 1} {
            set new_weight [expr {(1.0-$cvsm_relaxation)*$old_weight + $cvsm_relaxation*$target}]
            if {$new_weight < $cvsm_min} { set new_weight $cvsm_min }
            if {$new_weight > $cvsm_max} { set new_weight $cvsm_max }
            lappend new_cvsm $new_weight
        } else {
            lappend new_cvsm $old_weight
        }
    }

    return [list $new_cvsm $target $qvar $zvar]
}

